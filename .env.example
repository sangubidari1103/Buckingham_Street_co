# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Credentials
# Set a secure email and password for the admin panel
# The admin user must be created in Supabase Auth dashboard first
ADMIN_EMAIL=admin@suitgalleria.com
ADMIN_PASSWORD=your-secure-password-here